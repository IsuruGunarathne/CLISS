#!/bin/bash

BASE="/usr/share/cliss"
echo "Welcome to CLISS - Command Line Interface Screen Savers"
echo "--------------------------------------------------------"

options=(ASCIIWave DualWaves LoadingBar LogStream Matrix Progress SystemMonitor "Quit")

select opt in "${options[@]}"
do
    case $opt in
        ASCIIWave) exec "$BASE/ASCIIWave" ;;
        DualWaves) exec "$BASE/DualWaves" ;;
        LoadingBar) exec "$BASE/LoadingBar" ;;
        LogStream) exec "$BASE/LogStream" ;;
        Matrix) exec "$BASE/Matrix" ;;
        Progress) exec "$BASE/Progress" ;;
        SystemMonitor) exec "$BASE/SystemMonitor" ;;
        Quit) exit ;;
        *) echo "Invalid option. Please choose again." ;;
    esac
done
