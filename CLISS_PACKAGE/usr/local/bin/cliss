#!/bin/bash

options=("Matrix" "LogStream" "LoadingBar" "SystemMonitor" "ASCIIWave" "Progress" "Quit")
select opt in "${options[@]}"
do
    case $opt in
        Matrix) exec matrix ;;
        LogStream) exec logstream ;;
        LoadingBar) exec loadingbar ;;
        SystemMonitor) exec systemmonitor ;;
        ASCIIWave) exec asciiwave ;;
        Progress) exec progress ;;
        Quit) exit ;;
        *) echo "Invalid option";;
    esac
done
