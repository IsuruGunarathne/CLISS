#!/bin/bash
# CLISS - Command Line Interface Screen Savers
#
#   cliss                 pick a screensaver from the menu
#   cliss <name>          run one directly (case-insensitive, e.g. cliss fire)
#   cliss random          run a random one
#   cliss shuffle [secs]  cycle through random ones (default 60s each)
#   cliss list            list what is installed
#   cliss --version       show the installed version

BASE="${CLISS_HOME:-/usr/share/cliss}"
# Running from a git checkout? Use the Animations folder next to this script.
SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [[ -z "$CLISS_HOME" && -d "$SELF_DIR/Animations" ]]; then
    BASE="$SELF_DIR/Animations"
fi

# package.sh writes VERSION next to the screensavers; a checkout asks git
if [[ -f "$BASE/VERSION" ]]; then
    VERSION="$(<"$BASE/VERSION")"
else
    VERSION="$(git -C "$SELF_DIR" describe --tags 2>/dev/null || echo dev)"
fi

NAMES=()
FILES=()
for f in "$BASE"/*; do
    [[ -f "$f" && "$(basename "$f")" != VERSION ]] || continue
    name="$(basename "$f")"
    name="${name%.*}"
    NAMES+=("$name")
    FILES+=("$f")
done

if [[ ${#NAMES[@]} -eq 0 ]]; then
    echo "cliss: no screensavers found in $BASE" >&2
    exit 1
fi

describe() {
    grep -m1 '^# cliss:' "$1" 2>/dev/null | sed 's/^# cliss: *//'
}

# the command that runs screensaver $1, in the CMD array
command_for() {
    local f="${FILES[$1]}"
    case "$f" in
        *.py) CMD=(python3 "$f") ;;
        *.sh) CMD=(bash "$f") ;;
        *) CMD=("$f") ;;
    esac
}

launch() {
    command_for "$1"
    "${CMD[@]}"
}

find_index() {
    local want="${1,,}"
    for i in "${!NAMES[@]}"; do
        if [[ "${NAMES[$i],,}" == "$want" ]]; then
            echo "$i"
            return 0
        fi
    done
    return 1
}

shuffle() {
    local secs="${1:-60}"
    if ! [[ "$secs" =~ ^[0-9]+$ ]] || [[ "$secs" -eq 0 ]]; then
        echo "cliss: shuffle needs a number of seconds, got '$secs'" >&2
        exit 1
    fi
    local last=-1 i
    while true; do
        i=$((RANDOM % ${#NAMES[@]}))
        [[ ${#NAMES[@]} -gt 1 && $i -eq $last ]] && continue
        last=$i
        # the Python screensavers exit with 3 when their time is up;
        # for the shell ones `timeout` ends them (status 124)
        command_for "$i"
        CLISS_DURATION="$secs" timeout --foreground "$((secs + 1))" "${CMD[@]}"
        status=$?
        clear
        [[ $status -eq 3 || $status -eq 124 ]] || break
    done
}

banner() {
    local colors=(196 202 208 214 220 226)
    local lines=(
        "   ██████╗██╗     ██╗███████╗███████╗"
        "  ██╔════╝██║     ██║██╔════╝██╔════╝"
        "  ██║     ██║     ██║███████╗███████╗"
        "  ██║     ██║     ██║╚════██║╚════██║"
        "  ╚██████╗███████╗██║███████║███████║"
        "   ╚═════╝╚══════╝╚═╝╚══════╝╚══════╝"
    )
    for i in "${!lines[@]}"; do
        printf '\e[38;5;%sm%s\e[0m\n' "${colors[$i]}" "${lines[$i]}"
    done
    printf '\e[2m  Command Line Interface Screen Savers · %s\e[0m\n\n' "$VERSION"
}

menu() {
    clear
    banner
    for i in "${!NAMES[@]}"; do
        printf '  \e[1;36m%2d\e[0m  \e[1m%-14s\e[0m \e[2m%s\e[0m\n' \
            "$((i + 1))" "${NAMES[$i]}" "$(describe "${FILES[$i]}")"
    done
    printf '\n  \e[1;36m r\e[0m  \e[1m%-14s\e[0m \e[2m%s\e[0m\n' "Random" "Surprise me"
    printf '  \e[1;36m s\e[0m  \e[1m%-14s\e[0m \e[2m%s\e[0m\n' "Shuffle" "A new one every minute"
    printf '  \e[1;36m q\e[0m  \e[1m%-14s\e[0m\n\n' "Quit"
    printf '  \e[2mWhile running: any key exits, space pauses.\e[0m\n\n'
}

if [[ $# -gt 0 ]]; then
    case "${1,,}" in
        -h|--help|help)
            sed -n '2,9s/^# \{0,1\}//p' "$0"
            exit 0 ;;
        -v|--version|version)
            echo "cliss $VERSION"
            exit 0 ;;
        list|ls)
            for i in "${!NAMES[@]}"; do
                printf '%-14s %s\n' "${NAMES[$i]}" "$(describe "${FILES[$i]}")"
            done
            exit 0 ;;
        random)
            launch $((RANDOM % ${#NAMES[@]}))
            exit ;;
        shuffle)
            shuffle "$2"
            exit 0 ;;
        *)
            if i=$(find_index "$1"); then
                launch "$i"
                exit
            fi
            echo "cliss: unknown screensaver '$1' (try: cliss list)" >&2
            exit 1 ;;
    esac
fi

while true; do
    menu
    read -rp "  Pick one: " choice || exit 0
    case "${choice,,}" in
        q|quit|exit) clear; exit 0 ;;
        r|random) launch $((RANDOM % ${#NAMES[@]})) ;;
        s|shuffle) shuffle 60 ;;
        *)
            if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#NAMES[@]} )); then
                launch $((choice - 1))
            elif i=$(find_index "$choice"); then
                launch "$i"
            fi ;;
    esac
done
