#!/bin/bash
# CLISS - Command Line Interface Screen Savers
#
#   cliss                 pick a screensaver from the menu
#   cliss <name>          run one directly (e.g. cliss fire, cliss syn, cliss sm)
#   cliss random          run a random one
#   cliss shuffle [secs]  cycle through random ones (default 60s each)
#   cliss lock [...]      lock the screen when it ends (default: shuffle)
#   cliss list            list what is installed
#   cliss --version       show the installed version

# This script sticks to bash 3.2 features, since that's what macOS ships.

BASE="${CLISS_HOME:-/usr/share/cliss}"

# Follow symlinks to find where this script really lives
# (no `readlink -f`: older macOS doesn't have it).
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
    target="$(readlink "$SELF")"
    [[ "$target" == /* ]] && SELF="$target" || SELF="$(dirname "$SELF")/$target"
done
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"
# Running from a git checkout? Use the Animations folder next to this script.
if [[ -z "$CLISS_HOME" && -d "$SELF_DIR/Animations" ]]; then
    BASE="$SELF_DIR/Animations"
fi

# package.sh writes VERSION next to the screensavers; a checkout asks git
if [[ -f "$BASE/VERSION" ]]; then
    VERSION="$(<"$BASE/VERSION")"
else
    VERSION="$(git -C "$SELF_DIR" describe --tags 2>/dev/null || echo dev)"
fi

NAMES=()
FILES=()
for f in "$BASE"/*; do
    [[ -f "$f" && "$(basename "$f")" != VERSION ]] || continue
    name="$(basename "$f")"
    name="${name%.*}"
    NAMES+=("$name")
    FILES+=("$f")
done

if [[ ${#NAMES[@]} -eq 0 ]]; then
    echo "cliss: no screensavers found in $BASE" >&2
    exit 1
fi

describe() {
    grep -m1 '^# cliss:' "$1" 2>/dev/null | sed 's/^# cliss: *//'
}

# the command that runs screensaver $1, in the CMD array
command_for() {
    local f="${FILES[$1]}"
    case "$f" in
        *.py) CMD=(python3 "$f") ;;
        *.sh) CMD=(bash "$f") ;;
        *) CMD=("$f") ;;
    esac
}

launch() {
    command_for "$1"
    "${CMD[@]}"
}

lower() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

# indexes of the screensavers whose name starts with $1
starting_with() {
    local want i
    want="$(lower "$1")"
    for i in "${!NAMES[@]}"; do
        [[ "$(lower "${NAMES[$i]}")" == "$want"* ]] && echo "$i"
    done
}

# Index of the screensaver $1 names, ignoring case: the full name, the
# initials of a multi-word name (sm = SystemMonitor), or the start of
# exactly one name (syn = Synthwave)
find_index() {
    local want initials i matches
    want="$(lower "$1")"
    [[ -n "$want" ]] || return 1
    for i in "${!NAMES[@]}"; do
        if [[ "$(lower "${NAMES[$i]}")" == "$want" ]]; then
            echo "$i"
            return 0
        fi
    done
    for i in "${!NAMES[@]}"; do
        initials="$(printf '%s' "${NAMES[$i]}" | tr -cd '[:upper:]')"
        if [[ ${#initials} -gt 1 && "$(lower "$initials")" == "$want" ]]; then
            echo "$i"
            return 0
        fi
    done
    matches="$(starting_with "$1")"
    if [[ -n "$matches" && "$matches" != *$'\n'* ]]; then
        echo "$matches"
        return 0
    fi
    return 1
}

# tell the user why find_index found nothing for $1
name_error() {
    local i options=""
    [[ -n "$1" ]] && for i in $(starting_with "$1"); do
        options="$options ${NAMES[$i]}"
    done
    if [[ -n "$options" ]]; then
        echo "cliss: '$1' could be:$options" >&2
    else
        echo "cliss: unknown screensaver '$1' (try: cliss list)" >&2
    fi
}

shuffle() {
    local secs="${1:-60}"
    if ! [[ "$secs" =~ ^[0-9]+$ ]] || [[ "$secs" -eq 0 ]]; then
        echo "cliss: shuffle needs a number of seconds, got '$secs'" >&2
        exit 1
    fi
    local last=-1 i
    while true; do
        i=$((RANDOM % ${#NAMES[@]}))
        [[ ${#NAMES[@]} -gt 1 && $i -eq $last ]] && continue
        last=$i
        # the Python screensavers exit with 3 when their time is up; anything
        # else is ended by GNU `timeout` (status 124) where it's available
        # (macOS doesn't ship it, and busybox's lacks --foreground)
        command_for "$i"
        if [[ "${CMD[0]}" != python3 ]] && timeout --version 2>/dev/null | grep -q GNU; then
            CLISS_DURATION="$secs" timeout --foreground "$((secs + 1))" "${CMD[@]}"
        else
            CLISS_DURATION="$secs" "${CMD[@]}"
        fi
        status=$?
        clear
        [[ $status -eq 3 || $status -eq 124 ]] || break
    done
}

banner() {
    local colors=(196 202 208 214 220 226)
    local lines=(
        "   ██████╗██╗     ██╗███████╗███████╗"
        "  ██╔════╝██║     ██║██╔════╝██╔════╝"
        "  ██║     ██║     ██║███████╗███████╗"
        "  ██║     ██║     ██║╚════██║╚════██║"
        "  ╚██████╗███████╗██║███████║███████║"
        "   ╚═════╝╚══════╝╚═╝╚══════╝╚══════╝"
    )
    for i in "${!lines[@]}"; do
        printf '\e[38;5;%sm%s\e[0m\n' "${colors[$i]}" "${lines[$i]}"
    done
    printf '\e[2m  Command Line Interface Screen Savers · %s\e[0m\n\n' "$VERSION"
}

menu() {
    clear
    banner
    for i in "${!NAMES[@]}"; do
        printf '  \e[1;36m%2d\e[0m  \e[1m%-14s\e[0m \e[2m%s\e[0m\n' \
            "$((i + 1))" "${NAMES[$i]}" "$(describe "${FILES[$i]}")"
    done
    printf '\n  \e[1;36m r\e[0m  \e[1m%-14s\e[0m \e[2m%s\e[0m\n' "Random" "Surprise me"
    printf '  \e[1;36m s\e[0m  \e[1m%-14s\e[0m \e[2m%s\e[0m\n' "Shuffle" "A new one every minute"
    printf '  \e[1;36m q\e[0m  \e[1m%-14s\e[0m\n\n' "Quit"
    printf '  \e[2mWhile running: any key exits, space pauses.\e[0m\n\n'
}

if [[ $# -gt 0 ]]; then
    case "$(lower "$1")" in
        -h|--help|help)
            sed -n '2,10s/^# \{0,1\}//p' "$0"
            exit 0 ;;
        -v|--version|version)
            echo "cliss $VERSION"
            exit 0 ;;
        list|ls)
            for i in "${!NAMES[@]}"; do
                printf '%-14s %s\n' "${NAMES[$i]}" "$(describe "${FILES[$i]}")"
            done
            exit 0 ;;
        random)
            launch $((RANDOM % ${#NAMES[@]}))
            exit ;;
        shuffle)
            shuffle "$2"
            exit 0 ;;
        lock)
            shift
            [[ $# -eq 0 ]] && set -- shuffle 60
            case "$(lower "$1")" in
                random|shuffle) ;;
                *)
                    if ! find_index "$1" >/dev/null; then
                        name_error "$1"
                        exit 1
                    fi ;;
            esac
            # the watchdog locks the screen once this process ends, or as
            # soon as another app comes to the front
            python3 "$BASE/lib/lockwatch.py" "$$" </dev/null >/dev/null 2>&1 &
            disown
            # exec keeps this PID, so the watchdog follows the screensaver
            exec "$SELF" "$@" ;;
        *)
            if i=$(find_index "$1"); then
                launch "$i"
                exit
            fi
            name_error "$1"
            exit 1 ;;
    esac
fi

while true; do
    menu
    read -rp "  Pick one: " choice || exit 0
    case "$(lower "$choice")" in
        q|quit|exit) clear; exit 0 ;;
        r|random) launch $((RANDOM % ${#NAMES[@]})) ;;
        s|shuffle) shuffle 60 ;;
        *)
            if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#NAMES[@]} )); then
                launch $((choice - 1))
            elif i=$(find_index "$choice"); then
                launch "$i"
            fi ;;
    esac
done
